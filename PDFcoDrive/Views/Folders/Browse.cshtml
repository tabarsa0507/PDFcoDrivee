@{
    ViewData["Title"] = "مشاهده پوشه";
    var folder = ViewBag.CurrentFolder as PDFcoDrive.Models.Folder;
    var children = ViewBag.Children as List<PDFcoDrive.Models.Folder> ?? new();
    var files = ViewBag.Files as List<PDFcoDrive.Models.FileItem> ?? new();
    var breadcrumb = ViewBag.Breadcrumb as List<PDFcoDrive.Models.Folder> ?? new();
    var canUpload = ViewBag.CanUpload as bool? ?? false;
    var canManage = ViewBag.CanManage as bool? ?? false;
    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    string? returnUrl = ViewBag.ReturnUrl as string;
}

<div class="page-header">
    <h1>@folder?.Name</h1>
    <p>@(folder?.Description ?? "محتوای پوشه")</p>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert-modern success">
        <i class="bi bi-check-circle-fill"></i>
        <span>@TempData["Success"]</span>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert-modern error">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <span>@TempData["Error"]</span>
    </div>
}

<div class="breadcrumb-modern">
    @if (!string.IsNullOrEmpty(returnUrl))
    {
        <a href="@returnUrl">
            <i class="bi bi-house-door"></i> بازگشت
        </a>
    }
    else
    {
        <a asp-action="Index">
            <i class="bi bi-house-door"></i> خانه
        </a>
    }
    @foreach (var item in breadcrumb)
    {
        <i class="bi bi-chevron-left"></i>
        <a asp-action="Browse" asp-route-id="@item.Id" asp-route-returnUrl="@returnUrl">@item.Name</a>
    }
</div>

<div class="page-actions">
    @if (canManage)
    {
        <a asp-action="Create" asp-route-parentId="@folder?.Id" asp-route-returnUrl="@returnUrl" class="btn-modern btn-modern-primary">
            <i class="bi bi-folder-plus"></i>
            زیرپوشه جدید
        </a>
        <a asp-action="Edit" asp-route-id="@folder?.Id" asp-route-returnUrl="@returnUrl" class="btn-modern btn-modern-outline">
            <i class="bi bi-pencil"></i>
            ویرایش
        </a>
        <form asp-action="Delete" asp-route-id="@folder?.Id" asp-route-returnUrl="@returnUrl" method="post"
              style="display: inline; margin: 0;"
              onsubmit="return confirm('حذف شود؟');">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn-modern btn-modern-danger">
                <i class="bi bi-trash"></i>
                حذف
            </button>
        </form>
    }
    @if (canUpload)
    {
        <a asp-controller="Files" asp-action="Upload" asp-route-folderId="@folder?.Id" class="btn-modern btn-modern-primary">
            <i class="bi bi-cloud-upload-fill"></i>
            آپلود فایل
        </a>
    }
</div>

@if (children.Any())
{
    <h3 class="section-title">
        <i class="bi bi-folder-fill"></i>
        زیرپوشه‌ها (@children.Count)
    </h3>
    <div class="folders-grid mb-4">
        @foreach (var child in children)
        {
            <a asp-action="Browse" asp-route-id="@child.Id" asp-route-returnUrl="@returnUrl"
               class="folder-card" style="text-decoration: none; color: inherit;">
                <div class="folder-card-icon" style="background: @child.Color;">
                    <i class="bi @child.Icon"></i>
                </div>
                <div class="folder-card-body">
                    <h4>@child.Name</h4>
                </div>
                <i class="bi bi-chevron-left folder-card-arrow"></i>
            </a>
        }
    </div>
}

@if (files.Any())
{
    <h3 class="section-title">
        <i class="bi bi-file-earmark-fill"></i>
        فایل‌ها (@files.Count)
    </h3>

    <div class="files-grid">
        @foreach (var file in files)
        {
            var canDelete = file.UploadedByUserId == currentUserId || User.IsInRole("Admin") || User.IsInRole("Board");

            <div class="file-card">
                <div class="file-card-icon">
                    <i class="bi @GetFileIcon(file.Extension)"></i>
                </div>
                <div class="file-card-body">
                    <h4>@file.DisplayName</h4>
                    <div class="file-card-meta">
                        <span><i class="bi bi-hdd"></i> @FormatSize(file.SizeBytes)</span>
                        <span><i class="bi bi-download"></i> @file.DownloadCount</span>
                    </div>
                </div>
                <div class="file-card-actions">
                    <a asp-controller="Files" asp-action="Download" asp-route-id="@file.Id" class="btn-action download" title="دانلود">
                        <i class="bi bi-download"></i>
                    </a>
                    <a asp-controller="Files" asp-action="Details" asp-route-id="@file.Id" class="btn-action" title="جزئیات">
                        <i class="bi bi-eye"></i>
                    </a>
                    <a asp-action="SaveToMyFolder" asp-route-fileId="@file.Id"
                       class="btn-action" title="انتقال به پوشه"
                       style="color: #fbbf24 !important; background: rgba(251, 191, 36, 0.15) !important; border-color: rgba(251, 191, 36, 0.4) !important;">
                        <i class="bi bi-folder-symlink"></i>
                    </a>
                    <a asp-action="ShareFile" asp-route-fileId="@file.Id"
                       class="btn-action" title="اشتراک‌گذاری"
                       style="color: #10b981 !important; background: rgba(16, 185, 129, 0.15) !important; border-color: rgba(16, 185, 129, 0.4) !important;">
                        <i class="bi bi-share-fill"></i>
                    </a>
                    @if (canDelete)
                    {
                        <form asp-action="DeleteFile" method="post"
                              onsubmit="return confirm('به سبد بازیافت منتقل شود؟');"
                              style="display: inline;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="fileId" value="@file.Id" />
                            <input type="hidden" name="currentFolderId" value="@folder?.Id" />
                            <button type="submit" class="btn-action delete" title="حذف">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    }
                </div>
            </div>
        }
    </div>
}
else if (!children.Any())
{
    <div class="card-modern">
        <div class="empty-state-modern">
            <div class="empty-icon">
                <i class="bi bi-inbox"></i>
            </div>
            <h4>این پوشه خالیه</h4>
            <p>می‌تونی زیرپوشه بسازی یا فایل آپلود کنی</p>
        </div>
    </div>
}

@functions {
    string FormatSize(long bytes)
    {
        if (bytes == 0) return "0 B";
        string[] sizes = { "B", "KB", "MB", "GB", "TB" };
        double len = bytes;
        int order = 0;
        while (len >= 1024 && order < sizes.Length - 1) { order++; len = len / 1024; }
        return $"{len:0.##} {sizes[order]}";
    }

    string GetFileIcon(string ext)
    {
        return ext.ToLower() switch
        {
            ".pdf" => "bi-file-pdf-fill",
            ".doc" or ".docx" => "bi-file-word-fill",
            ".xls" or ".xlsx" => "bi-file-excel-fill",
            ".ppt" or ".pptx" => "bi-file-ppt-fill",
            ".jpg" or ".jpeg" or ".png" or ".gif" or ".webp" => "bi-file-image-fill",
            ".zip" or ".rar" or ".7z" => "bi-file-zip-fill",
            ".mp4" or ".mkv" or ".avi" => "bi-file-play-fill",
            ".mp3" or ".wav" => "bi-file-music-fill",
            ".txt" or ".md" => "bi-file-text-fill",
            _ => "bi-file-earmark-fill"
        };
    }
}
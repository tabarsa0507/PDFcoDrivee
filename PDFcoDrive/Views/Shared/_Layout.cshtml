<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PDFcoDrive</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/dark-pro.css" asp-append-version="true" />
</head>
<body>
    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

        var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "User";
        var isAdmin = role == "Admin";
        var isBoard = role == "Board";
        var isPrivileged = isAdmin || isBoard;

        var returnUrl = Context.Request.Query["returnUrl"].ToString();
        var isFilesContext = currentController == "Files"
        || (currentController == "Folders" && returnUrl.StartsWith("/Files", StringComparison.OrdinalIgnoreCase));
    }

    <div class="app-wrapper">

        <!-- ============ SIDEBAR ============ -->
        <aside class="app-sidebar" id="appSidebar">
            <div class="sidebar-brand">
                <div class="brand-icon">
                    <i class="bi bi-hdd-network-fill"></i>
                </div>
                <div class="brand-info">
                    <h5>PDFcoDrive</h5>
                    <span>پیشگامان دنیای فناوری</span>
                </div>
            </div>

            <nav class="sidebar-nav">
                <span class="nav-section">منوی اصلی</span>

                <a asp-controller="Home" asp-action="Index"
                   class="nav-link-custom @(currentController == "Home" && currentAction == "Index" ? "active" : "")">
                    <i class="bi bi-grid-1x2-fill"></i>
                    <span>داشبورد</span>
                </a>

                <a asp-controller="Files" asp-action="Upload"
                   class="nav-link-custom @(currentController == "Files" && currentAction == "Upload" ? "active" : "")">
                    <i class="bi bi-cloud-upload-fill"></i>
                    <span>آپلود فایل</span>
                </a>

                <a asp-controller="Folders" asp-action="Index"
                   class="nav-link-custom @(currentController == "Folders" && !isFilesContext ? "active" : "")">
                    <i class="bi bi-folder-fill"></i>
                    <span>پوشه‌ها</span>
                </a>

                @if (isPrivileged)
                {
                    <a asp-controller="Files" asp-action="Index"
                       class="nav-link-custom @(isFilesContext ? "active" : "")">
                        <i class="bi bi-files"></i>
                        <span>فایل‌های من</span>
                    </a>
                }

                <a asp-controller="Categories" asp-action="Index"
                   class="nav-link-custom @(currentController == "Categories" ? "active" : "")">
                    <i class="bi bi-tags-fill"></i>
                    <span>دسته‌بندی‌ها</span>
                </a>

                <a asp-controller="Trash" asp-action="Index"
                   class="nav-link-custom @(currentController == "Trash" ? "active" : "")">
                    <i class="bi bi-trash-fill"></i>
                    <span>سبد بازیافت</span>
                </a>

                <span class="nav-section">مدیریت</span>

                <a asp-controller="Users" asp-action="Index"
                   class="nav-link-custom @(currentController == "Users" ? "active" : "")">
                    <i class="bi bi-people-fill"></i>
                    <span>کاربران</span>
                </a>

                <a asp-controller="Reports" asp-action="Index"
                   class="nav-link-custom @(currentController == "Reports" ? "active" : "")">
                    <i class="bi bi-bar-chart-fill"></i>
                    <span>گزارش‌ها</span>
                </a>

                <a asp-controller="About" asp-action="Index"
                   class="nav-link-custom @(currentController == "About" ? "active" : "")">
                    <i class="bi bi-info-circle-fill"></i>
                    <span>درباره ما</span>
                </a>
            </nav>

            <div class="sidebar-footer">
                <div class="user-mini">
                    <div class="user-avatar">
                        <i class="bi bi-person-fill"></i>
                    </div>
                    <div class="user-info">
                        <strong>@(User.Identity?.Name ?? "کاربر")</strong>
                        <span>@(User.FindFirst("FullName")?.Value ?? "کاربر")</span>
                    </div>
                </div>
            </div>
        </aside>

        <!-- ============ MAIN AREA ============ -->
        <div class="app-main">

            <header class="app-topbar">
                <div class="topbar-right">
                    <button class="btn-icon" id="sidebarToggle" title="منو">
                        <i class="bi bi-list"></i>
                    </button>
                    <div class="search-box">
                        <i class="bi bi-search"></i>
                        <input type="text" placeholder="جستجو در فایل‌ها..." />
                    </div>
                </div>

                <div class="topbar-left">
                    <button class="btn-icon" title="اعلان‌ها">
                        <i class="bi bi-bell"></i>
                    </button>

                    @if (User.Identity?.IsAuthenticated ?? false)
                    {
                        <div class="dropdown">
                            <button class="user-chip" data-bs-toggle="dropdown">
                                <div class="user-avatar-sm">
                                    <i class="bi bi-person-fill"></i>
                                </div>
                                <div class="user-chip-info">
                                    <strong>@(User.Identity.Name)</strong>
                                    <span>@(User.FindFirst("FullName")?.Value ?? "کاربر")</span>
                                </div>
                                <i class="bi bi-chevron-down ms-1"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li>
                                    <a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword">
                                        <i class="bi bi-key"></i> تغییر رمز عبور
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post">
                                        <button type="submit" class="dropdown-item text-danger">
                                            <i class="bi bi-box-arrow-right"></i> خروج
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                </div>
            </header>

            <main class="app-content">
                @RenderBody()
            </main>

            <footer class="app-footer">
                <div class="footer-company">
                    <span>© 1405 - PDFcoDrive</span>
                    <a href="https://www.pdfco.ir" target="_blank" rel="noopener">
                        شرکت دانش بنیان پیشگامان دنیای فناوری
                        <i class="bi bi-box-arrow-up-left" style="font-size: 11px;"></i>
                    </a>
                </div>
            </footer>

        </div>
    </div>

    <div class="toast-container" id="toastContainer"></div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.getElementById('sidebarToggle')?.addEventListener('click', function () {
            document.getElementById('appSidebar').classList.toggle('collapsed');
        });

        window.showToast = function (message, type) {
            var container = document.getElementById('toastContainer');
            var toast = document.createElement('div');
            toast.className = 'toast-modern ' + (type || 'success');
            var icon = type === 'error' ? 'bi-x-circle-fill' : 'bi-check-circle-fill';
            toast.innerHTML = '<i class="bi ' + icon + '"></i><span>' + message + '</span>';
            container.appendChild(toast);
            setTimeout(function () {
                toast.style.transition = 'all 0.3s';
                toast.style.opacity = '0';
                toast.style.transform = 'translateX(-50px)';
                setTimeout(function () { toast.remove(); }, 300);
            }, 4000);
        };
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
@model PDFcoDrive.Models.User
@{
    ViewData["Title"] = "تغییر رمز عبور";
}

<div class="page-header">
    <h1>تغییر رمز عبور</h1>
    <p>@Model.FullName</p>
</div>

<div class="form-card">
    <form asp-action="ResetPassword" asp-route-id="@Model.Id" method="post">
        @Html.AntiForgeryToken()

        @if (ViewBag.Error != null)
        {
            <div class="alert-modern error">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <span>@ViewBag.Error</span>
            </div>
        }

        <div class="form-group">
            <label class="form-label-modern"><i class="bi bi-person-badge"></i> کاربر</label>
            <input type="text" value="@Model.FullName (@Model.NationalCode)" class="form-control-modern" readonly />
        </div>

        <div class="form-group">
            <label class="form-label-modern"><i class="bi bi-key"></i> رمز عبور جدید</label>
            <input type="password" name="newPassword" class="form-control-modern" required minlength="6" />
        </div>

        <div class="form-group">
            <label class="form-label-modern"><i class="bi bi-key-fill"></i> تکرار رمز جدید</label>
            <input type="password" name="confirmPassword" class="form-control-modern" required minlength="6" />
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-modern btn-modern-primary">
                <i class="bi bi-check-lg"></i> تغییر رمز
            </button>
            <a asp-action="Index" class="btn-modern btn-modern-outline">
                <i class="bi bi-x-lg"></i> انصراف
            </a>
        </div>
    </form>
</div>
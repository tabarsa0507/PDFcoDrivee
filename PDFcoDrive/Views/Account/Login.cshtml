@{
    ViewData["Title"] = "ورود به سیستم";
    Layout = null;
}

<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ورود | PDFcoDrive</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/login-dark.css" asp-append-version="true" />
</head>
<body>
    <div class="login-wrapper">
        <div class="login-container">

            <!-- پنل فرم (سمت راست) -->
            <div class="login-form-panel">
                <div class="login-form-content">
                    <h2 class="login-form-title">خوش آمدی!</h2>
                    <p class="login-form-subtitle">برای ادامه، کد ملی و رمز عبور خود را وارد کنید</p>

                    <form method="post" asp-controller="Account" asp-action="Login">
                        @Html.AntiForgeryToken()

                        @if (ViewBag.Error != null)
                        {
                            <div class="login-error">
                                <i class="bi bi-exclamation-circle-fill"></i>
                                <span>@ViewBag.Error</span>
                            </div>
                        }

                        <!-- کد ملی -->
                        <div class="login-input-wrapper">
                            <input type="text" name="nationalCode" autocomplete="username"
                                   placeholder="کد ملی (10 رقم)" maxlength="10"
                                   inputmode="numeric" pattern="\d{10}" required />
                            <i class="bi bi-person-badge"></i>
                        </div>

                        <!-- رمز عبور -->
                        <div class="login-input-wrapper">
                            <input type="password" name="password" autocomplete="current-password"
                                   placeholder="رمز عبور" required />
                            <i class="bi bi-lock"></i>
                        </div>

                        <!-- کپچا -->
                        <div class="captcha-row">
                            <div class="login-input-wrapper captcha-input">
                                <input type="text" name="captcha" autocomplete="off"
                                       placeholder="کد امنیتی" maxlength="5" required />
                                <i class="bi bi-shield-lock"></i>
                            </div>
                            <div class="captcha-image-wrapper" onclick="refreshCaptcha()" title="تغییر تصویر">
                                <img id="captchaImage" src="/Captcha/Image?t=@DateTime.Now.Ticks" alt="captcha" />
                                <button type="button" class="captcha-refresh" onclick="refreshCaptcha()" title="تصویر جدید">
                                    <i class="bi bi-arrow-clockwise"></i>
                                </button>
                            </div>
                        </div>

                        <div class="login-remember">
                            <label>
                                <input type="checkbox" name="rememberMe" value="true" />
                                <span>مرا به خاطر بسپار</span>
                            </label>
                        </div>

                        <button type="submit" class="login-btn">
                            <i class="bi bi-box-arrow-in-right"></i>
                            ورود به حساب
                        </button>
                    </form>

                    <div class="login-footer-note">
                        <i class="bi bi-info-circle"></i>
                        برای ساخت حساب با مدیر سیستم تماس بگیرید
                    </div>
                </div>
            </div>

            <!-- پنل اطلاعات (سمت چپ) -->
            <div class="login-info-panel">
                <div class="login-info-content">
                    <div class="login-badge">LOGIN</div>

                    <div class="login-illustration">
                        <i class="bi bi-hdd-network-fill"></i>
                    </div>

                    <h1 class="login-welcome-title">
                        به PDFcoDrive خوش آمدی
                    </h1>
                    <p class="login-welcome-text">
                        سیستم مدیریت فایل ابری شرکت پیشگامان دنیای فناوری. فایل‌های خود را آپلود، سازماندهی و به اشتراک بگذارید.
                    </p>

                    <div class="login-features">
                        <div class="login-feature">
                            <i class="bi bi-shield-check"></i>
                            <span>امنیت بالا</span>
                        </div>
                        <div class="login-feature">
                            <i class="bi bi-lightning-charge-fill"></i>
                            <span>سرعت بالا</span>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <script>
        function refreshCaptcha() {
            const img = document.getElementById('captchaImage');
            img.src = '/Captcha/Image?t=' + new Date().getTime();
        }
    </script>
</body>
</html>
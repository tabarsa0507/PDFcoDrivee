@{
    ViewData["Title"] = "درباره ما";
}

<div class="page-header">
    <h1>درباره ما</h1>
    <p>اطلاعات بیشتر درباره PDFcoDrive</p>
</div>

<!-- Hero -->
<div class="about-hero">
    <div class="about-icon">
        <i class="bi bi-hdd-network-fill"></i>
    </div>
    <h2>PDFcoDrive</h2>
    <p>سیستم مدیریت فایل ابری شرکت پیشگامان دنیای فناوری</p>
</div>

<!-- Features -->
<div class="row g-4 mt-4">
    <div class="col-md-6">
        <div class="about-card">
            <div class="about-card-icon purple">
                <i class="bi bi-shield-check"></i>
            </div>
            <h4>امنیت بالا</h4>
            <p>همه فایل‌ها با SHA256 هش می‌شن و پسوردها با PBKDF2 + Pepper محافظت می‌شن.</p>
        </div>
    </div>
    <div class="col-md-6">
        <div class="about-card">
            <div class="about-card-icon blue">
                <i class="bi bi-lightning-charge-fill"></i>
            </div>
            <h4>سرعت بالا</h4>
            <p>آپلود و دانلود سریع با پشتیبانی از Drag & Drop و ذخیره‌سازی بهینه.</p>
        </div>
    </div>
    <div class="col-md-6">
        <div class="about-card">
            <div class="about-card-icon green">
                <i class="bi bi-folder-fill"></i>
            </div>
            <h4>سازماندهی هوشمند</h4>
            <p>پوشه‌های تو در تو، دسته‌بندی و سطح دسترسی کامل.</p>
        </div>
    </div>
    <div class="col-md-6">
        <div class="about-card">
            <div class="about-card-icon orange">
                <i class="bi bi-people-fill"></i>
            </div>
            <h4>مدیریت کاربران</h4>
            <p>سیستم چند‌کاربره با نقش‌های Admin، Board و User.</p>
        </div>
    </div>
</div>

<!-- Company -->
<div class="company-card">
    <div class="company-header">
        <div class="company-logo">
            <i class="bi bi-building"></i>
        </div>
        <div>
            <h3>شرکت دانش بنیان پیشگامان دنیای فناوری</h3>
            <p>طراح و توسعه‌دهنده PDFcoDrive</p>
        </div>
    </div>

    <div class="company-info">
        <div class="company-info-row">
            <span><i class="bi bi-globe"></i> وب‌سایت:</span>
            <a href="https://www.pdfco.ir" target="_blank" rel="noopener">
                www.pdfco.ir
                <i class="bi bi-box-arrow-up-left"></i>
            </a>
        </div>
        <div class="company-info-row">
            <span><i class="bi bi-award"></i> نوع شرکت:</span>
            <strong>دانش بنیان</strong>
        </div>
        <div class="company-info-row">
            <span><i class="bi bi-code-slash"></i> تکنولوژی:</span>
            <strong>ASP.NET Core 9 + JSON Storage</strong>
        </div>
        <div class="company-info-row">
            <span><i class="bi bi-shield-lock"></i> امنیت:</span>
            <strong>PBKDF2 + SHA256 + Pepper</strong>
        </div>
    </div>

    <a href="https://www.pdfco.ir" target="_blank" rel="noopener" class="btn-modern btn-modern-primary" style="width: 100%; justify-content: center;">
        <i class="bi bi-globe"></i>
        بازدید از سایت شرکت
    </a>
</div>
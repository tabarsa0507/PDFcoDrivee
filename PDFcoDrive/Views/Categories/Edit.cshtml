@model PDFcoDrive.Models.Category
@{
    ViewData["Title"] = "ویرایش دسته‌بندی";
}

<div class="page-header">
    <h1>ویرایش دسته‌بندی</h1>
    <p>@Model.Name</p>
</div>

<div class="form-card">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="CreatedAt" />

        <div class="form-group">
            <label asp-for="Name" class="form-label-modern">
                <i class="bi bi-tag"></i> نام دسته‌بندی
            </label>
            <input asp-for="Name" class="form-control-modern" required />
        </div>

        <div class="form-group">
            <label asp-for="Description" class="form-label-modern">
                <i class="bi bi-text-paragraph"></i> توضیحات
            </label>
            <textarea asp-for="Description" class="form-control-modern" rows="3"></textarea>
        </div>

        <div class="row g-3">
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="Icon" class="form-label-modern">
                        <i class="bi bi-emoji-smile"></i> آیکون
                    </label>
                    <select asp-for="Icon" class="form-control-modern">
                        <option value="bi-folder-fill">📁 پوشه</option>
                        <option value="bi-file-pdf-fill">📄 PDF</option>
                        <option value="bi-file-word-fill">📝 ورد</option>
                        <option value="bi-file-excel-fill">📊 اکسل</option>
                        <option value="bi-file-image-fill">🖼️ تصویر</option>
                        <option value="bi-file-zip-fill">📦 فایل فشرده</option>
                        <option value="bi-file-play-fill">🎬 ویدیو</option>
                        <option value="bi-file-music-fill">🎵 صوتی</option>
                        <option value="bi-file-text-fill">📃 متنی</option>
                    </select>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="Color" class="form-label-modern">
                        <i class="bi bi-palette"></i> رنگ
                    </label>
                    <input asp-for="Color" type="color" class="form-control-modern color-input" />
                </div>
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-modern btn-modern-primary">
                <i class="bi bi-check-lg"></i> ذخیره
            </button>
            <a asp-action="Index" class="btn-modern btn-modern-outline">
                <i class="bi bi-x-lg"></i> انصراف
            </a>
        </div>
    </form>
</div>